<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Esseti.App"
             xmlns:local="using:Esseti"
             RequestedThemeVariant="Light">
             

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        
        <!-- Wspólne przyciski i akcje -->
        <Style Selector="Button.pill-btn">
            <Setter Property="Background" Value="#0033A0"/>
            <Setter Property="Foreground" Value="#FEFEFE"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pill-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#002270"/>
            <Setter Property="Foreground" Value="#FEFEFE"/>
        </Style>

        <Style Selector="Button.btn-cancel">
            <Setter Property="Background" Value="#FEFEFE"/>
            <Setter Property="BorderBrush" Value="#dde2f0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.btn-cancel:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#f5f7ff"/>
            <Setter Property="BorderBrush" Value="#ccd3ee"/>
            <Setter Property="Foreground" Value="#666666"/>
        </Style>

        <Style Selector="Button.btn-save">
            <Setter Property="Background" Value="#0033A0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="22,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.btn-save:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#002270"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.modal-close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.modal-close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2EFFFFFF"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>

        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="#f4f6fc"/>
            <Setter Property="BorderBrush" Value="#d0d8ed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0033A0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0033A0"/>
            <Setter Property="BorderBrush" Value="#0033A0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.ActionBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        <Style Selector="Button.ActionBtn PathIcon">
            <Setter Property="Foreground" Value="#0033A0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.DeleteBtn">
            <Setter Property="Background" Value="#fff5f5"/>
            <Setter Property="BorderBrush" Value="#fcdada"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DeleteBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="BorderBrush" Value="#D32F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.DeleteBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        <Style Selector="Button.DeleteBtn PathIcon">
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DeleteBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Przyciski w popupach (zamiast powielonych stylów inline) -->
        <Style Selector="Button.popup-btn">
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.popup-cancel">
            <Setter Property="Background" Value="#f0f2f8"/>
            <Setter Property="Foreground" Value="#7a8099"/>
        </Style>
        <Style Selector="Button.popup-cancel:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#e2e6f2"/>
            <Setter Property="Foreground" Value="#4a5099"/>
        </Style>

        <Style Selector="Button.popup-primary">
            <Setter Property="Background" Value="#0033A0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.popup-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#002480"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.popup-danger">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.popup-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B71C1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Style walidacyjne -->
        <Style Selector="TextBox.invalid">
            <Setter Property="BorderBrush" Value="#D32F2F"/>
        </Style>
        <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#D32F2F"/>
            <Setter Property="Background" Value="#FFF5F5"/>
        </Style>
        <Style Selector="TextBox.invalid:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#E53935"/>
            <Setter Property="Background" Value="#FFEAEA"/>
        </Style>
        <Style Selector="TextBox.invalid:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#D32F2F"/>
            <Setter Property="Background" Value="#FFF5F5"/>
        </Style>

        <Style Selector="ComboBox.invalid">
            <Setter Property="BorderBrush" Value="#D32F2F"/>
        </Style>
        <Style Selector="ComboBox.invalid /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#D32F2F"/>
            <Setter Property="Background" Value="#FFF5F5"/>
        </Style>
        <Style Selector="ComboBox.invalid:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#E53935"/>
            <Setter Property="Background" Value="#FFEAEA"/>
        </Style>
        <Style Selector="ComboBox.invalid:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#D32F2F"/>
            <Setter Property="Background" Value="#FFF5F5"/>
        </Style>

        <Style Selector="DatePicker.invalid">
            <Setter Property="BorderBrush" Value="#D32F2F"/>
        </Style>

        <!-- Elementy list / wiersze -->
        <Style Selector="Border.list-row">
            <Setter Property="BorderBrush" Value="#dde2f0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="#FEFEFE"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.list-row:pointerover">
            <Setter Property="BoxShadow" Value="0 2 12 0 #140033A0"/>
        </Style>
        <Style Selector="Border.list-row.selected">
            <Setter Property="BorderBrush" Value="#0033A0"/>
            <Setter Property="Background" Value="#f3f6ff"/>
        </Style>

        <!-- Wspólne kontrolki CheckBox -->
        <Style Selector="CheckBox.MemberCheckBox">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="CheckBox.MemberCheckBox /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="#b0bde8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="CheckBox.MemberCheckBox:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="#0033A0"/>
        </Style>

        <!-- Wspólne style formularzy (Inputs) -->
        <Style Selector="TextBlock.form-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0033A0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        
        <Style Selector="TextBox.form-input">
            <Setter Property="Background" Value="#FEFEFE"/>
            <Setter Property="Foreground" Value="#1a1a2e"/>
            <Setter Property="BorderBrush" Value="#dde2f0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.form-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#b0bde8"/>
            <Setter Property="Background" Value="#f9faff"/>
        </Style>
        <Style Selector="TextBox.form-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#0033A0"/>
            <Setter Property="Background" Value="#FEFEFE"/>
        </Style>
        
        <Style Selector="TextBox.form-textarea">
            <Setter Property="Background" Value="#FEFEFE"/>
            <Setter Property="Foreground" Value="#1a1a2e"/>
            <Setter Property="BorderBrush" Value="#dde2f0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.form-textarea:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#b0bde8"/>
            <Setter Property="Background" Value="#f9faff"/>
        </Style>
        <Style Selector="TextBox.form-textarea:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#0033A0"/>
            <Setter Property="Background" Value="#FEFEFE"/>
        </Style>
        
        <Style Selector="ComboBox.form-select">
            <Setter Property="Background" Value="#FEFEFE"/>
            <Setter Property="Foreground" Value="#1a1a2e"/>
            <Setter Property="BorderBrush" Value="#dde2f0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBox.form-select:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#b0bde8"/>
            <Setter Property="Background" Value="#f9faff"/>
        </Style>
        <Style Selector="ComboBox.form-select:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#0033A0"/>
            <Setter Property="Background" Value="#FEFEFE"/>
        </Style>
    </Application.Styles>
</Application>