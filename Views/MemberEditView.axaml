<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Esseti.ViewModels"
             x:Class="Esseti.Views.MemberEditView"
             x:DataType="vm:MemberProfileViewModel"
             Padding="10">

    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#f5f7ff"/>
            <Setter Property="Foreground" Value="#1a1a2e"/>
            <Setter Property="BorderBrush" Value="#dde2f0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#b0bde8"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#0033A0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#ffffff"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Foreground" Value="#1a1a2e"/>
        </Style>

        <Style Selector="Button.PremiumBtn">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.PremiumBtn:pointerover /template/ ContentPresenter">
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.PremiumBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#0033A0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#002480"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="#f0f2f8"/>
            <Setter Property="Foreground" Value="#7a8099"/>
        </Style>
        <Style Selector="Button.Secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#e2e6f2"/>
            <Setter Property="Foreground" Value="#4a5099"/>
        </Style>


        <Style Selector="Border.ItemCard">
            <Setter Property="Background" Value="#FEFEFE"/>
            <Setter Property="BorderBrush" Value="#eef1ff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.ItemCard:pointerover">
            <Setter Property="Background" Value="#f8f9ff"/>
            <Setter Property="BorderBrush" Value="#dde2f0"/>
        </Style>

        <Style Selector="Button.RemoveBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.RemoveBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFF4F4"/>
        </Style>
        <Style Selector="Button.RemoveBtn PathIcon">
            <Setter Property="Foreground" Value="#c0c8e8"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
        <Style Selector="Button.RemoveBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="#D32F2F"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,32">
            <TextBlock Text="Edytuj profil członka"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1a1a2e"/>
            <TextBlock Text="Wprowadź zmiany w danych osobowych i zarządzaj przynależnością do grup."
                       FontSize="14"
                       Foreground="#7a8099"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" MaxHeight="550" Padding="0,0,16,0">
            <StackPanel Spacing="36">

                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="5" Height="18" Background="#0033A0" CornerRadius="2.5"/>
                        <TextBlock Text="DANE PODSTAWOWE" FontSize="12" FontWeight="Black" Foreground="#0033A0" LetterSpacing="1.2" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, 24, *">
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="Imię" FontSize="12" FontWeight="Bold" Foreground="#7a8099" Margin="4,0"/>
                            <TextBox Text="{Binding EditFirstName}" Watermark="np. Jan"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Text="Nazwisko" FontSize="12" FontWeight="Bold" Foreground="#7a8099" Margin="4,0"/>
                            <TextBox Text="{Binding EditLastName}" Watermark="np. Kowalski"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*, 24, *">
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="Adres e-mail" FontSize="12" FontWeight="Bold" Foreground="#7a8099" Margin="4,0"/>
                            <TextBox Text="{Binding EditEmail}" Watermark="jan.kowalski@ur.edu.pl"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Text="Numer telefonu" FontSize="12" FontWeight="Bold" Foreground="#7a8099" Margin="4,0"/>
                            <TextBox Text="{Binding EditPhoneNumber}" Watermark="+48 000 000 000"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*, 24, *">
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="Numer indeksu" FontSize="12" FontWeight="Bold" Foreground="#7a8099" Margin="4,0"/>
                            <TextBox Text="{Binding EditIndexNumber}" Watermark="123456"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Text="Kierunek studiów" FontSize="12" FontWeight="Bold" Foreground="#7a8099" Margin="4,0"/>
                            <TextBox Text="{Binding EditMajor}" Watermark="Informatyka"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Opis profilu" FontSize="12" FontWeight="Bold" Foreground="#7a8099" Margin="4,0"/>
                        <TextBox Text="{Binding EditDescription}" 
                                 Watermark="Napisz kilka słów o sobie..." 
                                 AcceptsReturn="True" 
                                 Height="120" 
                                 VerticalContentAlignment="Top" 
                                 Padding="14,12"/>
                    </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="*, 40, *">
                    <StackPanel Grid.Column="0" Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="5" Height="18" Background="#0033A0" CornerRadius="2.5"/>
                            <TextBlock Text="PROJEKTY" FontSize="12" FontWeight="Black" Foreground="#0033A0" LetterSpacing="1.2" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="ItemCard">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#1a1a2e" TextWrapping="Wrap"/>
                                                <TextBlock Text="Uczestnik" FontSize="12" Foreground="#7a8099"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" 
                                                    Classes="RemoveBtn"
                                                    Command="{Binding $parent[UserControl].DataContext.RemoveFromProjectCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <Border Background="#f5f7ff" CornerRadius="10" Padding="16" IsVisible="{Binding !HasProjects}">
                            <TextBlock Text="Brak przypisanych projektów" FontSize="12" Foreground="#7a8099" HorizontalAlignment="Center" FontStyle="Italic"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="5" Height="18" Background="#0033A0" CornerRadius="2.5"/>
                            <TextBlock Text="AKTYWNOŚCI" FontSize="12" FontWeight="Black" Foreground="#0033A0" LetterSpacing="1.2" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Activities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="ItemCard">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#1a1a2e" TextWrapping="Wrap"/>
                                                <Border Background="#eef1ff" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Date}" FontSize="10" Foreground="#0033A0" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="1" 
                                                    Classes="RemoveBtn"
                                                    Command="{Binding $parent[UserControl].DataContext.RemoveFromActivityCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#f5f7ff" CornerRadius="10" Padding="16" IsVisible="{Binding !HasActivities}">
                            <TextBlock Text="Brak przypisanych aktywności" FontSize="12" Foreground="#7a8099" HorizontalAlignment="Center" FontStyle="Italic"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FEFEFE" Margin="0,32,0,0" Padding="0,24,0,0" BorderBrush="#f0f2f8" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                <Button Classes="PremiumBtn Secondary"
                        Content="Anuluj"
                        Command="{Binding CancelEditCommand}"
                        Width="160"
                        Height="52"/>

                <Button Classes="PremiumBtn Primary"
                        Content="Zapisz zmiany"
                        Command="{Binding SaveEditCommand}"
                        Width="240"
                        Height="52"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
