<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:Esseti.ViewModels"
             xmlns:vmm="using:Esseti.ViewModels.Member"
             x:DataType="vmc:MembersViewModel"
             x:Class="Esseti.Views.MembersView">

    <UserControl.Styles>
        <Style Selector="CheckBox.CardCheck">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
        </Style>

        <Style Selector="CheckBox.CardCheck /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#bbc4e0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#FEFEFE"/>
        </Style>

        <Style Selector="CheckBox.CardCheck:checked /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#0033A0"/>
            <Setter Property="BorderBrush" Value="#0033A0"/>
        </Style>

        <Style Selector="Border.MemberCard">
            <Setter Property="Width" Value="160"/>
            <Setter Property="BorderBrush" Value="#dde2f0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="#FEFEFE"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style Selector="Border.MemberCard:pointerover">
            <Setter Property="BoxShadow" Value="0 4 16 0 #1A0033A0"/>
        </Style>

        <Style Selector="Border.MemberCard.Selected">
            <Setter Property="BorderBrush" Value="#0033A0"/>
            <Setter Property="Background" Value="#f3f6ff"/>
        </Style>

        <Style Selector="Button.CardAction">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.CardAction:pointerover">
            <Setter Property="Background" Value="#eef1ff"/>
            <Setter Property="Foreground" Value="#0033A0"/>
        </Style>

        <Style Selector="Button.CardAction.Profile">
            <Setter Property="Foreground" Value="#0033A0"/>
        </Style>

        <Style Selector="Button.CardAction.Profile:pointerover">
            <Setter Property="Background" Value="#0033A0"/>
            <Setter Property="Foreground" Value="#FEFEFE"/>
        </Style>

        <Style Selector="Button.CardAction.Delete:pointerover">
            <Setter Property="Background" Value="#fff0f0"/>
            <Setter Property="Foreground" Value="#c0001a"/>
        </Style>

        <Style Selector="Border.AddCard">
            <Setter Property="Width" Value="160"/>
            <Setter Property="MinHeight" Value="214"/>
            <Setter Property="BorderBrush" Value="#b0bde8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="#f7f8ff"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Border.AddCard:pointerover">
            <Setter Property="Background" Value="#eef1ff"/>
            <Setter Property="BorderBrush" Value="#0033A0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" Background="#e8eaf0" Padding="20,16">
            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vmm:MemberItemViewModel">
                        <Panel>
                            <Border Classes="MemberCard" Classes.Selected="{Binding IsSelected}" IsVisible="{Binding !IsSystemAddTile}">
                                <Grid RowDefinitions="70,*,Auto">
                                    <Border Grid.Row="0" Background="#0033A0">
                                        <Panel>
                                            <Ellipse Width="50" Height="50" Fill="#FEFEFE" Stroke="#FFFFFF99" StrokeThickness="2.5"/>
                                            <Ellipse Width="45" Height="45">
                                                <Ellipse.Fill>
                                                    <ImageBrush Source="{Binding Avatar}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <CheckBox Classes="CardCheck" IsChecked="{Binding IsSelected}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,8"/>
                                        </Panel>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="10,9,10,10" Spacing="3">
                                        <TextBlock Text="{Binding FullName}" FontSize="12.5" FontWeight="Bold" TextAlignment="Center" Foreground="Black"/>
                                        <TextBlock Text="{Binding IndexNumber}" FontSize="10" TextAlignment="Center" Foreground="#555"/>
                                        <TextBlock Text="{Binding Role}" FontSize="10" TextAlignment="Center" Foreground="#555"/>
                                        <TextBlock Text="{Binding Email}" FontSize="10" TextAlignment="Center" Foreground="#555"/>
                                        <TextBlock Text="{Binding CollegeDepartment}" FontSize="10" TextAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Major}" FontSize="10" TextAlignment="Center" Foreground="#555"/>
                                        <Border Background="#0033A0" CornerRadius="20" Padding="0,4" Margin="0,9,0,0">
                                            <TextBlock Text="{Binding FullFromDate}" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" Foreground="#FEFEFE"/>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Row="2" BorderBrush="#e8ecf5" BorderThickness="0,1,0,0" x:CompileBindings="False">
                                        <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                                            <Button Grid.Column="0" Classes="CardAction Profile" Command="{Binding $parent[UserControl].DataContext.OpenProfileCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" Width="11" Height="11" Foreground="{Binding $parent[Button].Foreground}"/>
                                                    <TextBlock Text="Profil"/>
                                                </StackPanel>
                                            </Button>
                                            <Border Grid.Column="1" Width="1" Background="#e8ecf5"/>
                                            <Button Grid.Column="2" Classes="CardAction" Command="{Binding $parent[UserControl].DataContext.EditMemberCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" Width="11" Height="11" Foreground="{Binding $parent[Button].Foreground}"/>
                                                    <TextBlock Text="Edytuj"/>
                                                </StackPanel>
                                            </Button>
                                            <Border Grid.Column="3" Width="1" Background="#e8ecf5"/>
                                            <Button Grid.Column="4" Classes="CardAction Delete" Command="{Binding $parent[UserControl].DataContext.DeleteMemberCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" Width="11" Height="11" Foreground="{Binding $parent[Button].Foreground}"/>
                                                    <TextBlock Text="Usuń"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Classes="AddCard" IsVisible="{Binding IsSystemAddTile}">
                                <Button Background="Transparent" BorderThickness="0" Command="{Binding $parent[UserControl].DataContext.AddMemberCommand, FallbackValue={x:Null}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <StackPanel Spacing="11" HorizontalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#0033A0">
                                            <TextBlock Text="+" FontSize="20" Foreground="#FEFEFE" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                        </Border>
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#0033A0" TextAlignment="Center" LineHeight="16">
                                            <Run Text="Dodaj"/>
                                            <LineBreak/>
                                            <Run Text="członka"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#0033A0" Padding="10,20" IsVisible="{Binding IsAnySelected}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" FontSize="12.5" FontWeight="Bold" Foreground="#FEFEFE" VerticalAlignment="Center">
                    <Run Text="Zaznaczono:"/>
                    <Run Text="{Binding SelectedCount}"/>
                    <Run Text="członków"/>
                </TextBlock>

                <Button Grid.Column="1" Background="Transparent" BorderBrush="#FFFFFF80" BorderThickness="1.5" CornerRadius="20" Padding="6,16" Margin="0,0,12,0" Foreground="#FEFEFE" FontSize="12" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" Width="12" Height="12" Foreground="#FEFEFE"/>
                        <TextBlock Text="Edytuj wszystkie"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Background="Transparent" BorderBrush="#ff6b6b" BorderThickness="1.5" CornerRadius="20" Padding="6,16" Foreground="#ffb3b3" FontSize="12" FontWeight="SemiBold" Command="{Binding DeleteSelectedCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" Width="12" Height="12" Foreground="#ffb3b3"/>
                        <TextBlock Text="Usuń zaznaczone"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>