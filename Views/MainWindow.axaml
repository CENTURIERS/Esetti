<Window xmlns="https://github.com/avaloniaui"
        xmlns:componentmodel="using:System.ComponentModel"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Esseti.ViewModels"
        xmlns:views="using:Esseti.Views"
        xmlns:components="using:Esseti.Views.Components"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="Esseti.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        FontFamily="Corbel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Esseti">

<Window.Styles>
    
    <Style Selector="Button.LeftPanelButton">
        <Setter Property="Background" Value="{ReflectionBinding $parent[Window].DataContext.SidebarButtonBackgroundColor}"/> 
        <Setter Property="Foreground" Value="{ReflectionBinding $parent[Window].DataContext.SidebarButtonTextColor}"/> 
        <Setter Property="FontSize" Value="20"/>

        <Setter Property="Padding" Value="20, 15"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/> 
        <Setter Property="HorizontalContentAlignment" Value="Center" /> 
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="50"/> 
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.LeftPanelButton /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.LeftPanelButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{ReflectionBinding $parent[Window].DataContext.SidebarButtonHoverBackgroundColor}"/> 
    </Style>

    <Style Selector="Button.LeftPanelButton:pointerover">
        <Setter Property="Foreground" Value="{ReflectionBinding $parent[Window].DataContext.SidebarButtonHoverTextColor}"/> 
    </Style>

    <Style Selector="Button.LeftPanelButton > StackPanel">
        <Setter Property="Width" Value="150" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.LeftPanelButton > StackPanel > :is(Control)">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.LeftPanelButton PathIcon">
        <Setter Property="Foreground" Value="{ReflectionBinding $parent[Window].DataContext.SidebarButtonTextColor}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
                <BrushTransition Property="Foreground" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.LeftPanelButton:pointerover PathIcon">
        <Setter Property="Foreground" Value="{ReflectionBinding $parent[Window].DataContext.SidebarButtonHoverTextColor}"/>
    </Style>

    <Style Selector="Button.LeftPanelButton:pointerover TextBlock">
        <Setter Property="Foreground" Value="{ReflectionBinding $parent[Window].DataContext.SidebarButtonHoverTextColor}"/>
    </Style>

    <Style Selector="Button.LeftPanelButton.Active /template/ ContentPresenter">
        <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.LeftPanelButton.Active">
        <Setter Property="Foreground" Value="#0033A0"/>
    </Style>
    <Style Selector="Button.LeftPanelButton.Active PathIcon">
        <Setter Property="Foreground" Value="#0033A0"/>
    </Style>
    <Style Selector="Button.LeftPanelButton.Active TextBlock">
        <Setter Property="Foreground" Value="#0033A0"/>
    </Style>

    <Style Selector="Border.SearchBarBorder">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Width" Value="350"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="50"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
    </Style>

    <Style Selector="Border.SearchBarBorder TextBox">
        <Setter Property="Background" Value="#f5f7ff"/>
        <Setter Property="Foreground" Value="#000"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="#dde2f0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="50"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="SelectionBrush" Value="#500033A0"/>
    </Style>

    <Style Selector="Border.SearchBarBorder TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#f5f7ff"/>
        <Setter Property="BorderBrush" Value="#dde2f0"/>
    </Style>

    <Style Selector="Border.SearchBarBorder TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="#0033A0"/>
    </Style>

    <Style Selector="Border.SearchBarBorder TextBox:focus">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="CaretBrush" Value="Black"/>
    </Style>

    <Style Selector="Button.BulkDeleteButton">
        <Setter Property="Background" Value="#FFF4F4"/>
        <Setter Property="BorderBrush" Value="#FFE0E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Button.BulkDeleteButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FFE5E5"/>
        <Setter Property="BorderBrush" Value="#FFD0D0"/>
    </Style>

    <Style Selector="Button.BulkDeleteButton PathIcon">
        <Setter Property="Foreground" Value="#D32F2F"/>
    </Style>

    <Style Selector="Button.BulkDeleteButton TextBlock">
        <Setter Property="Foreground" Value="#D32F2F"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="CheckBox.SelectAllCheckBox">
        <Setter Property="Foreground" Value="#7a8099"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    
    <Style Selector="CheckBox.SelectAllCheckBox:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#0033A0"/>
    </Style>

    <Style Selector="CheckBox.SelectAllCheckBox:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#0033A0"/>
    </Style>
    
    <Style Selector="CheckBox.SelectAllCheckBox /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="#b0bde8"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="CheckBox.SelectAllCheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="#0033A0"/>
    </Style>

    <Style Selector="Button.ModalCancelButton">
        <Setter Property="Background" Value="#f0f2f8"/>
        <Setter Property="Foreground" Value="#7a8099"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0,12"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.ModalCancelButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#e2e6f2"/>
    </Style>

    <Style Selector="Button.ModalDeleteButton">
        <Setter Property="Background" Value="#D32F2F"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0,12"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.ModalDeleteButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#B71C1C"/>
    </Style>

</Window.Styles>

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:StartViewModel}">
			<views:StartView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MembersViewModel}">
			<views:MembersView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ActivitiesViewModel}">
			<views:ActivitiesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ClubInfoViewModel}">
			<views:ClubInfoView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
			<views:DocumentsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
			<views:ProjectsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
			<views:SettingsView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:MemberProfileViewModel}">
            <views:MemberProfileView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProjectProfileViewModel}">
            <views:ProjectProfileView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ActivityProfileViewModel}">
            <views:ActivityProfileView />
        </DataTemplate>
    </Window.DataTemplates>


    <Grid ColumnDefinitions="250, *">
        <Grid RowDefinitions="Auto, *, Auto" Grid.Column="0" Background="{Binding SidebarColor}">
			<Border Grid.Row="0" Padding="0,0,0,5">
                <Image Source="{Binding HeaderLogo}" />
            </Border>

            <Border Grid.Row="1" VerticalAlignment="Top" Padding="5,0,5,0">
                <StackPanel Orientation="Vertical" Spacing="5">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
						<ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <components:NavigationItem  Classes="LeftPanelButton"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0, 0, 0, 20"  Padding="5,0,5,0">
		        <Button Classes="LeftPanelButton" Classes.Active="{Binding IsSettingsActive}" Command="{Binding ShowSettingsPageCommand}">
					<StackPanel Orientation="Horizontal" Spacing="15">
						<PathIcon Width="24" Height="24" Data="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492 M5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0 M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52z M7.163 1.626c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115z" />
                        <TextBlock Text="Ustawienia" />
                    </StackPanel>
                </Button>
            </Border>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="Auto, *">

            <Border Grid.Row="0" IsVisible="{Binding IsHeaderVisible}" Height="54" BorderBrush="#e4e7f0" BorderThickness="0,0,0,1" Background="#FEFEFE" Padding="20,0">
                <Grid ColumnDefinitions="Auto, *, Auto">
        
                    <TextBlock Grid.Column="0" 
                               VerticalAlignment="Center" 
                               Text="{Binding CurrentViewModel.PageTitle}" 
                               FontSize="14" 
                               FontWeight="Bold"
                               Foreground="#000000"/>

                    <Border Grid.Column="1" Classes="SearchBarBorder" VerticalAlignment="Center" IsVisible="{Binding CurrentViewModel.ShowActionHeader, FallbackValue=False}">
                        <TextBox Text="{Binding CurrentViewModel.SearchQuery, FallbackValue=''}"
                                 Watermark="{Binding CurrentViewModel.SearchPlaceholder, FallbackValue='Szukaj...'}" 
                                 >
                            <TextBox.InnerLeftContent>
                                <PathIcon Foreground="Gray" Height="16" Width="16" Margin="10,0,5,0" Data="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </Border>
        
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" IsVisible="{Binding CurrentViewModel.ShowActionHeader, FallbackValue=False}">
                        
                        <CheckBox Classes="SelectAllCheckBox"
                                  Content="Zaznacz wszystkich" 
                                  IsChecked="{Binding CurrentViewModel.IsAllSelected, FallbackValue=False}"
                                  FontWeight="SemiBold" 
                                  FontSize="13"
                                  VerticalAlignment="Center"/>
                        
                        <Button Classes="BulkDeleteButton" ToolTip.Tip="Usuń zaznaczonych członków" Command="{Binding CurrentViewModel.RequestDeleteCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" 
                                          Width="14" Height="14"/>
                                <TextBlock Text="Usuń zaznaczone" 
                                           FontSize="12" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#F5F5F5" Padding="0">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>

        </Grid>

        <Grid Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding CurrentViewModel.IsPopupVisible, FallbackValue=False}">
            
            <Border Background="#99000000" />

            <Border Width="400" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Background="#FEFEFE"
                    CornerRadius="14"
                    Padding="28,32"
                    BoxShadow="0 10 40 0 #40000000">
                
                <StackPanel Spacing="20">
                    <Panel HorizontalAlignment="Center" Width="60" Height="60">
                        <Ellipse Fill="#FFF4F4" />
                        <PathIcon Data="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" 
                                  Foreground="#D32F2F" Width="24" Height="24"/>
                    </Panel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Potwierdź usunięcie" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#000000" 
                                   HorizontalAlignment="Center"/>
                        
                        <TextBlock Text="Czy na pewno chcesz usunąć zaznaczone elementy? Te zmiany są nieodwracalne." 
                                   FontSize="13" 
                                   Foreground="#7a8099" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, *" Margin="0,10,0,0">
                        <Button Grid.Column="0" 
                                Classes="ModalCancelButton"
                                Content="Anuluj" 
                                Margin="0,0,8,0"
                                Command="{Binding CurrentViewModel.CancelDeleteCommand}"/>

                        <Button Grid.Column="1" 
                                Classes="ModalDeleteButton"
                                Content="Usuń" 
                                Margin="8,0,0,0"
                                Command="{Binding CurrentViewModel.ConfirmDeleteCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding CurrentViewModel.IsAddPopupVisible, FallbackValue=False}">

            <Border Background="#99000000" />

            <Border Width="420" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Background="#FEFEFE"
                    CornerRadius="14"
                    Padding="32,28"
                    BoxShadow="0 10 40 0 #40000000">

                <StackPanel Spacing="12">

                    <StackPanel Spacing="4" Margin="0,0,0,8">
                        <TextBlock Text="Dodaj nowego członka"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1a1a2e"/>
                        <TextBlock Text="Wypełnij dane nowego członka organizacji."
                                   FontSize="12"
                                   Foreground="#7a8099"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, 10, *">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Imię" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                            <TextBox Classes="form-input" Classes.invalid="{ReflectionBinding CurrentViewModel.IsAddFirstNameInvalid}" Watermark="np. Jan" Text="{ReflectionBinding CurrentViewModel.NewFirstName}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Nazwisko" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                            <TextBox Classes="form-input" Classes.invalid="{ReflectionBinding CurrentViewModel.IsAddLastNameInvalid}" Watermark="np. Kowalski" Text="{ReflectionBinding CurrentViewModel.NewLastName}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Adres e-mail" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-input" Classes.invalid="{ReflectionBinding CurrentViewModel.IsAddEmailInvalid}" Watermark="np. jan.kowalski@ur.edu.pl" Text="{ReflectionBinding CurrentViewModel.NewEmail}">
                            <TextBox.InnerLeftContent>
                                <PathIcon Foreground="#b0bde8" Height="14" Width="14" Margin="10,0,4,0"
                                          Data="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Numer telefonu" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-input" Watermark="np. +48 123 456 789" Text="{ReflectionBinding CurrentViewModel.NewPhoneNumber}">
                            <TextBox.InnerLeftContent>
                                <PathIcon Foreground="#b0bde8" Height="14" Width="14" Margin="10,0,4,0"
                                          Data="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Numer indeksu" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-input" Classes.invalid="{ReflectionBinding CurrentViewModel.IsAddIndexNumberInvalid}" Watermark="np. 123456" Text="{ReflectionBinding CurrentViewModel.NewIndexNumber}">
                            <TextBox.InnerLeftContent>
                                <PathIcon Foreground="#b0bde8" Height="14" Width="14" Margin="10,0,4,0"
                                          Data="M5.5 2A3.5 3.5 0 0 0 2 5.5v5A3.5 3.5 0 0 0 5.5 14h5a3.5 3.5 0 0 0 3.5-3.5V8a.5.5 0 0 1 1 0v2.5a4.5 4.5 0 0 1-4.5 4.5h-5A4.5 4.5 0 0 1 1 10.5v-5A4.5 4.5 0 0 1 5.5 1H8a.5.5 0 0 1 0 1zm7 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2m2-1a2 2 0 1 1-4 0 2 2 0 0 1 4 0"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Kierunek studiów" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-input" Watermark="np. Informatyka" Text="{ReflectionBinding CurrentViewModel.NewMajor}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Wydział" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <ComboBox Classes="form-select"
                                  ItemsSource="{ReflectionBinding CurrentViewModel.AvailableDepartments}"
                                  SelectedItem="{ReflectionBinding CurrentViewModel.SelectedDepartment}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{ReflectionBinding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, 10, *">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Rola w kole" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                            <ComboBox Classes="form-select"
                                      ItemsSource="{ReflectionBinding CurrentViewModel.AvailableRoles}"
                                      SelectedItem="{ReflectionBinding CurrentViewModel.SelectedRole}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Zdjęcie profilowe" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                            <Button Command="{ReflectionBinding CurrentViewModel.OpenAvatarPickerCommand}"
                                    HorizontalAlignment="Stretch" Height="35" CornerRadius="8"
                                    Background="#f5f7ff" BorderBrush="#dde2f0" BorderThickness="1.5"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" 
                                              Foreground="#0033A0" Width="14" Height="14"/>
                                    <TextBlock Text="Wybierz plik" Foreground="#1a1a2e" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Zmieniono zdjęcie" FontSize="10" Foreground="#00cc00" HorizontalAlignment="Right"
                                       IsVisible="{ReflectionBinding CurrentViewModel.NewAvatar, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Opis" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-textarea" Watermark="Krótki opis członka..." Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12,8" Text="{ReflectionBinding CurrentViewModel.NewDescription}"/>
                    </StackPanel>

                    <TextBlock Text="{ReflectionBinding CurrentViewModel.AddValidationError}"
                               Foreground="#D32F2F"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               IsVisible="{ReflectionBinding CurrentViewModel.AddValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Border Height="1" Background="#f0f2f8" Margin="0,4,0,4"/>

                    <Grid ColumnDefinitions="*, 12, *">
                        <Button Grid.Column="0"
                                Content="Anuluj"
                                VerticalContentAlignment="Center"
                                Command="{ReflectionBinding CurrentViewModel.CancelAddCommand}"
                                Background="#f0f2f8"
                                Foreground="#7a8099"
                                FontSize="13"
                                FontWeight="SemiBold"
                                CornerRadius="8"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#e2e6f2"/>
                                    <Setter Property="Foreground" Value="#4a5099"/>
                                </Style>
                            </Button.Styles>
                        </Button>

                        <Button Grid.Column="2"
                                Content="Dodaj członka"
                                VerticalContentAlignment="Center"
                                Command="{ReflectionBinding CurrentViewModel.ConfirmAddCommand}"
                                Background="#0033A0"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="SemiBold"
                                CornerRadius="8"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#002480"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{ReflectionBinding CurrentViewModel.IsListEditPopupVisible, FallbackValue=False}">
            <Border Background="#99000000" />
            <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#FEFEFE" CornerRadius="14" Padding="32,28" BoxShadow="0 10 40 0 #40000000">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4" Margin="0,0,0,8">
                        <TextBlock Text="Edytuj członka" FontSize="20" FontWeight="Bold" Foreground="#1a1a2e"/>
                        <TextBlock Text="Zaktualizuj dane wybranego członka." FontSize="12" Foreground="#7a8099"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*, 10, *">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Imię" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                            <TextBox Classes="form-input" Classes.invalid="{ReflectionBinding CurrentViewModel.IsEditFirstNameInvalid}" Watermark="np. Jan" Text="{ReflectionBinding CurrentViewModel.EditFirstName}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Nazwisko" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                            <TextBox Classes="form-input" Classes.invalid="{ReflectionBinding CurrentViewModel.IsEditLastNameInvalid}" Watermark="np. Kowalski" Text="{ReflectionBinding CurrentViewModel.EditLastName}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Adres e-mail" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-input" Classes.invalid="{ReflectionBinding CurrentViewModel.IsEditEmailInvalid}" Watermark="np. jan.kowalski@ur.edu.pl" Text="{ReflectionBinding CurrentViewModel.EditEmail}">
                            <TextBox.InnerLeftContent>
                                <PathIcon Foreground="#b0bde8" Height="14" Width="14" Margin="10,0,4,0" Data="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Numer telefonu" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-input" Watermark="np. +48 123 456 789" Text="{ReflectionBinding CurrentViewModel.EditPhoneNumber}">
                            <TextBox.InnerLeftContent>
                                <PathIcon Foreground="#b0bde8" Height="14" Width="14" Margin="10,0,4,0"
                                          Data="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Numer indeksu" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-input" Classes.invalid="{ReflectionBinding CurrentViewModel.IsEditIndexNumberInvalid}" Watermark="np. 123456" Text="{ReflectionBinding CurrentViewModel.EditIndexNumber}">
                            <TextBox.InnerLeftContent>
                                <PathIcon Foreground="#b0bde8" Height="14" Width="14" Margin="10,0,4,0" Data="M5.5 2A3.5 3.5 0 0 0 2 5.5v5A3.5 3.5 0 0 0 5.5 14h5a3.5 3.5 0 0 0 3.5-3.5V8a.5.5 0 0 1 1 0v2.5a4.5 4.5 0 0 1-4.5 4.5h-5A4.5 4.5 0 0 1 1 10.5v-5A4.5 4.5 0 0 1 5.5 1H8a.5.5 0 0 1 0 1zm7 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2m2-1a2 2 0 1 1-4 0 2 2 0 0 1 4 0"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Kierunek studiów" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-input" Watermark="np. Informatyka" Text="{ReflectionBinding CurrentViewModel.EditMajor}"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Wydział" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <ComboBox Classes="form-select"
                                  ItemsSource="{ReflectionBinding CurrentViewModel.AvailableDepartments}"
                                  SelectedItem="{ReflectionBinding CurrentViewModel.EditSelectedDepartment}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{ReflectionBinding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Grid ColumnDefinitions="*, 10, *">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Rola w kole" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                            <ComboBox Classes="form-select" ItemsSource="{ReflectionBinding CurrentViewModel.AvailableRoles}" SelectedItem="{ReflectionBinding CurrentViewModel.EditSelectedRole}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{ReflectionBinding Name}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Zdjęcie profilowe" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                            <Button Command="{ReflectionBinding CurrentViewModel.OpenEditAvatarPickerCommand}"
                                    HorizontalAlignment="Stretch" Height="35" CornerRadius="8"
                                    Background="#f5f7ff" BorderBrush="#dde2f0" BorderThickness="1.5"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" 
                                              Foreground="#0033A0" Width="14" Height="14"/>
                                    <TextBlock Text="Zmień plik" Foreground="#1a1a2e" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Zmieniono zdjęcie" FontSize="10" Foreground="#00cc00" HorizontalAlignment="Right"
                                       IsVisible="{ReflectionBinding CurrentViewModel.EditAvatar, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Opis" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-textarea" Watermark="Krótki opis członka..." Height="60" TextWrapping="Wrap" AcceptsReturn="True" Text="{ReflectionBinding CurrentViewModel.EditDescription}"/>
                    </StackPanel>
                    <TextBlock Text="{ReflectionBinding CurrentViewModel.EditValidationError}"
                               Foreground="#D32F2F"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               IsVisible="{ReflectionBinding CurrentViewModel.EditValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Border Height="1" Background="#f0f2f8" Margin="0,4,0,4"/>
                    <Grid ColumnDefinitions="*, 12, *">
                        <Button Grid.Column="0" Content="Anuluj" Command="{ReflectionBinding CurrentViewModel.CancelEditCommand}" Background="#f0f2f8" Foreground="#7a8099" FontSize="13" FontWeight="SemiBold" CornerRadius="8" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#e2e6f2"/>
                                    <Setter Property="Foreground" Value="#4a5099"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                        <Button Grid.Column="2" Content="Zapisz zmiany" Command="{ReflectionBinding CurrentViewModel.ConfirmEditCommand}" Background="#0033A0" Foreground="White" FontSize="13" FontWeight="SemiBold" CornerRadius="8" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#002480"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding CurrentViewModel.IsEditPopupVisible, FallbackValue=False}">
            <Border Background="#99000000" />
            <Border Width="800" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Background="#FEFEFE"
                    CornerRadius="16"
                    Padding="32"
                    BoxShadow="0 10 40 0 #40000000">
                <views:MemberEditView DataContext="{Binding CurrentViewModel}" />
            </Border>
        </Grid>

    </Grid>

</Window>