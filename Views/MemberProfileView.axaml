<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Esseti.ViewModels"
             x:Class="Esseti.Views.MemberProfileView"
             x:DataType="vm:MemberProfileViewModel"
             xmlns:conv="using:Avalonia.Data.Converters"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Button.BackBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#7a8099"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.BackBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#eef1ff"/>
            <Setter Property="Foreground" Value="#0033A0"/>
        </Style>
        <Style Selector="Button.BackBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="#0033A0"/>
        </Style>
        <Style Selector="Button.BackBtn:pointerover TextBlock">
            <Setter Property="Foreground" Value="#0033A0"/>
        </Style>

        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="#f4f6fc"/>
            <Setter Property="BorderBrush" Value="#d0d8ed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0033A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0033A0"/>
            <Setter Property="BorderBrush" Value="#0033A0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.ActionBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        <Style Selector="Button.ActionBtn PathIcon">
            <Setter Property="Foreground" Value="#0033A0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.DeleteBtn">
            <Setter Property="Background" Value="#fff5f5"/>
            <Setter Property="BorderBrush" Value="#fcdada"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DeleteBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="BorderBrush" Value="#D32F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.DeleteBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        <Style Selector="Button.DeleteBtn PathIcon">
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DeleteBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="28,20,28,32">

            <Button Classes="BackBtn" Command="{Binding GoBackCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="13" Height="13" Foreground="#7a8099"
                              Data="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
                    <TextBlock Text="Wróć do listy członków" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Text="Ładowanie profilu..." FontSize="14" Foreground="#b0bde8"
                       HorizontalAlignment="Center" Margin="0,60"
                       IsVisible="{Binding IsLoading}"/>

            <StackPanel Spacing="14" IsVisible="{Binding !IsLoading}">

                <Border Background="#FEFEFE" CornerRadius="16" BoxShadow="0 2 20 0 #0E000000">
                    <Grid ColumnDefinitions="*, Auto, 280">

                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    Spacing="24" Margin="28,24">
                            <Border Width="90" Height="90" CornerRadius="45"
                                    ClipToBounds="True" BorderBrush="#dde2f0" BorderThickness="2">
                                <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center" Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding FullName}" FontSize="22"
                                               FontWeight="Bold" Foreground="#1a1a2e" VerticalAlignment="Center"/>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="ActionBtn" Command="{Binding OpenEditCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <PathIcon Width="12" Height="12" Data="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                                <TextBlock Text="Edytuj" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Classes="DeleteBtn" Command="{Binding DeleteThisMemberCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <PathIcon Width="12" Height="12" Data="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                <TextBlock Text="Usuń" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <Border Background="#eef1ff" CornerRadius="50"
                                        Padding="12,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Role}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="#0033A0"/>
                                </Border>

                                <StackPanel Spacing="5" Margin="0,4,0,0">

                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding Major, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                        <PathIcon Width="12" Height="12" Foreground="#c0c8e8"
                                                  Data="M8.211 2.047a.5.5 0 0 0-.422 0l-7.5 3.5a.5.5 0 0 0 .025.917l7.5 3a.5.5 0 0 0 .372 0L14 7.14V13a1 1 0 0 0-1 1v2h3v-2a1 1 0 0 0-1-1V6.739l.686-.275a.5.5 0 0 0 .025-.917z"/>
                                        <TextBlock Text="{Binding Major}" FontSize="12"
                                                   Foreground="#7a8099" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding Email, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                        <PathIcon Width="12" Height="12" Foreground="#c0c8e8"
                                                  Data="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
                                        <TextBlock Text="{Binding Email}" FontSize="12"
                                                   Foreground="#0033A0" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding PhoneNumber, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                        <PathIcon Width="12" Height="12" Foreground="#c0c8e8"
                                                  Data="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58z"/>
                                        <TextBlock Text="{Binding PhoneNumber}" FontSize="12"
                                                   Foreground="#7a8099" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="12" Height="12" Foreground="#c0c8e8"
                                                  Data="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
                                        <TextBlock Text="{Binding JoinDate}" FontSize="12"
                                                   Foreground="#7a8099" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding IndexNumber, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                        <PathIcon Width="12" Height="12" Foreground="#c0c8e8"
                                                  Data="M5.5 2A3.5 3.5 0 0 0 2 5.5v5A3.5 3.5 0 0 0 5.5 14h5a3.5 3.5 0 0 0 3.5-3.5V8a.5.5 0 0 1 1 0v2.5a4.5 4.5 0 0 1-4.5 4.5h-5A4.5 4.5 0 0 1 1 10.5v-5A4.5 4.5 0 0 1 5.5 1H8a.5.5 0 0 1 0 1z"/>
                                        <TextBlock Text="{Binding IndexNumber}" FontSize="12"
                                                   Foreground="#7a8099" VerticalAlignment="Center"/>
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="#e4e7f0" Margin="0,20"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    Spacing="6" Margin="28,24">
                            <TextBlock Text="{Binding CollegeName}" FontSize="15" FontWeight="Bold"
                                       Foreground="#1a1a2e" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DepartmentName}" FontSize="13"
                                       Foreground="#7a8099" TextWrapping="Wrap"
                                       IsVisible="{Binding DepartmentName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding DepartmentAddress}" FontSize="12"
                                       Foreground="#9aa0b8" TextWrapping="Wrap"
                                       IsVisible="{Binding DepartmentAddress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding CollegeNip}" FontSize="12" Foreground="#9aa0b8"
                                       IsVisible="{Binding CollegeNip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="14" Margin="0,4,0,0">
                    
                    <Border Background="#FEFEFE" CornerRadius="16" Padding="28,20"
                            BoxShadow="0 2 20 0 #0E000000">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="4" Height="18" Background="#0033A0"
                                        CornerRadius="2" VerticalAlignment="Center"/>
                                <TextBlock Text="O członku" FontSize="15" FontWeight="Bold"
                                           Foreground="#1a1a2e" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                       FontSize="13" Foreground="#4a4a6a" LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FEFEFE" CornerRadius="16" Padding="28,20"
                            BoxShadow="0 2 20 0 #0E000000">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="4" Height="18" Background="#0033A0"
                                        CornerRadius="2" VerticalAlignment="Center"/>
                                <TextBlock Text="Aktywności" FontSize="15" FontWeight="Bold"
                                           Foreground="#1a1a2e" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Brak aktywności." FontSize="13" Foreground="#c0c8e8"
                                       HorizontalAlignment="Center" Margin="0,16,0,8"
                                       IsVisible="{Binding !HasActivities}"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                                <ItemsControl ItemsSource="{Binding Activities}"
                                              IsVisible="{Binding HasActivities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ActivityProfileItem">
                                            <Border Background="#f8f9ff" CornerRadius="10" Padding="14,12"
                                                    Margin="0,0,0,8" BorderBrush="#eef1ff" BorderThickness="1">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   FontSize="13" Foreground="#1a1a2e" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding PersonInCharge}"
                                                                   FontSize="11" Foreground="#7a8099"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#eef1ff" CornerRadius="50"
                                                            Padding="10,4" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Date}" FontSize="10"
                                                                   Foreground="#0033A0" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Background="#FEFEFE" CornerRadius="16" Padding="28,20"
                            BoxShadow="0 2 20 0 #0E000000">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="4" Height="18" Background="#0033A0"
                                        CornerRadius="2" VerticalAlignment="Center"/>
                                <TextBlock Text="Projekty" FontSize="15" FontWeight="Bold"
                                           Foreground="#1a1a2e" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Brak projektów." FontSize="13" Foreground="#c0c8e8"
                                       HorizontalAlignment="Center" Margin="0,16,0,8"
                                       IsVisible="{Binding !HasProjects}"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding HasProjects}">
                                <ItemsControl ItemsSource="{Binding Projects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="14"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProjectCardItem">
                                            <Border Width="230" Background="#f8f9ff" CornerRadius="12"
                                                    Padding="18,16" BorderBrush="#dde2f0" BorderThickness="1">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="KARTA PROJEKTOWA" FontSize="9"
                                                               FontWeight="Bold" Foreground="#0033A0"
                                                               LetterSpacing="1"/>
                                                    <Border Height="1" Background="#dde2f0"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="16"
                                                               FontWeight="Black" Foreground="#0033A0"
                                                               FontStyle="Italic" TextWrapping="Wrap"/>
                                                    <StackPanel Spacing="5">
                                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="6">
                                                            <TextBlock Grid.Column="0" Text="Lider:"
                                                                       FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="#1a1a2e"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding LeaderName}"
                                                                       FontSize="12" Foreground="#7a8099"
                                                                       TextWrapping="Wrap"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="6">
                                                            <TextBlock Grid.Column="0" Text="Ilość osób:"
                                                                       FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="#1a1a2e"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ParticipantCount}"
                                                                       FontSize="12" Foreground="#7a8099"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="6">
                                                            <TextBlock Grid.Column="0" Text="Sekcja:"
                                                                       FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="#0033A0"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding SectionNames}"
                                                                       FontSize="12" Foreground="#0033A0"
                                                                       TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </StackPanel>
                                                    <Border Height="1" Background="#dde2f0"/>
                                                    <TextBlock Text="Zamysł projektu:"
                                                               FontWeight="Bold" FontStyle="Italic"
                                                               FontSize="11" Foreground="#1a1a2e"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               TextWrapping="Wrap" FontSize="11"
                                                               Foreground="#7a8099" MaxHeight="80"
                                                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>