<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmc="using:Esseti.ViewModels"
             xmlns:mu="using:Models.Users"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Esseti.Views.ProjectsView"
             x:DataType="vmc:ProjectsViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Button.iconButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.iconButton PathIcon">
            <Setter Property="Foreground" Value="#7a8099"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.iconButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#f0f2f8"/>
        </Style>
        <Style Selector="Button.iconButton:pointerover PathIcon">
            <Setter Property="Foreground" Value="#0033A0"/>
        </Style>

        <Style Selector="Panel.AddProjectTile">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Panel.AddProjectTile Rectangle">
            <Setter Property="Fill" Value="#f7f8ff"/>
            <Setter Property="Stroke" Value="#b0bde8"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeDashArray" Value="6, 4"/>
            <Setter Property="RadiusX" Value="11"/>
            <Setter Property="RadiusY" Value="11"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.15"/>
                    <BrushTransition Property="Stroke" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.AddProjectTile:pointerover Rectangle">
            <Setter Property="Fill" Value="#eef1ff"/>
            <Setter Property="Stroke" Value="#0033A0"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Border Background="#FEFEFE" 
                CornerRadius="14" 
                BorderBrush="#d0d4e8" 
                BorderThickness="1" 
                BoxShadow="0 6 28 0 #1A0033A0" 
                ClipToBounds="True"
                Margin="20">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="#FEFEFE" BorderBrush="#e4e7f0" BorderThickness="0,1,0,0" Padding="16,12" Height="60">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <Button Classes="iconButton" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}" ToolTip.Tip="Poprzednia strona">
                            <PathIcon Data="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z" />
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Strona" Foreground="#7a8099" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentPage}" FontWeight="SemiBold" Foreground="#0033A0" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="z" Foreground="#7a8099" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalPages}" FontWeight="SemiBold" Foreground="#0033A0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Classes="iconButton" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" ToolTip.Tip="Następna strona">
                            <PathIcon Data="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z" />
                        </Button>
                    </StackPanel>
                </Border>
                <ScrollViewer Padding="20,16,20,30">
                    <StackPanel Spacing="9" HorizontalAlignment="Stretch">
                        
                        <Panel Classes="AddProjectTile" Height="58" Margin="0,0,0,9">
                            <Rectangle />
                            <Button HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Stretch" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Command="{Binding OpenAddPopupCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                    <Panel Width="32" Height="32">
                                        <Ellipse Fill="#0033A0"/>
                                        <PathIcon Data="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2" 
                                                  Foreground="White" 
                                                  Width="14" Height="14" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Panel>
                                    <TextBlock Text="DODAJ PROJEKT" FontWeight="UltraBlack" Foreground="#0033A0" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Panel>

                        
                        <ItemsControl ItemsSource="{Binding Projects}" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="9"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="list-row" Classes.selected="{Binding IsSelected}" Padding="16,0" Height="58">
                                        <Grid ColumnDefinitions="40, *, Auto">
                                            
                                            <CheckBox Grid.Column="0" 
                                                      Classes="MemberCheckBox" 
                                                      IsChecked="{Binding IsSelected}" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                            
                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,20,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontFamily="Georgia" 
                                                               FontStyle="Italic" 
                                                               FontSize="14" 
                                                               FontWeight="Bold" 
                                                               Foreground="Black"/>
                                                    <TextBlock Text="•" Foreground="Gray" VerticalAlignment="Center" FontSize="12"/>
                                                    <TextBlock Text="{Binding LeaderName, StringFormat='Lider: {0}'}" 
                                                               FontSize="12" 
                                                               Foreground="#555555" 
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" 
                                                           FontSize="11.5" 
                                                           Foreground="#777777" 
                                                           TextWrapping="NoWrap" 
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                
                                                <Border Background="#f0f2f8" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EstimatedTime}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0033A0"/>
                                                </Border>
                                                
                                                
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Classes="ActionBtn" 
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.OpenProfileCommand}" 
                                                            CommandParameter="{Binding}"
                                                            Padding="12,6"
                                                            FontSize="11">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <PathIcon Width="11" Height="11" Data="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0 M10 8a2 2 0 1 0-4 0 2 2 0 0 0 4 0 M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8 M1.173 8a13 13 0 0 0 1.66 2.043C4.12 11.332 5.88 12.5 8 12.5s3.88-1.168 5.168-2.457A13 13 0 0 0 14.828 8q-.086-.13-.195-.288c-.335-.48-.83-1.12-1.465-1.755C11.879 4.668 10.119 3.5 8 3.5s-3.879 1.168-5.168 2.457A13 13 0 0 0 1.172 8"/>
                                                            <TextBlock Text="Szczegóły" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    
                                                    <Button Classes="ActionBtn" 
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.OpenEditPopupCommand}" 
                                                            CommandParameter="{Binding}"
                                                            Padding="12,6"
                                                            FontSize="11">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <PathIcon Width="11" Height="11" Data="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                                            <TextBlock Text="Edytuj" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    
                                                    <Button Classes="DeleteBtn" 
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteSingleProjectCommand}" 
                                                            CommandParameter="{Binding}"
                                                            Padding="12,6"
                                                            FontSize="11">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <PathIcon Width="11" Height="11" Data="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                            <TextBlock Text="Usuń" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="20" Background="Transparent" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        
        <Grid Background="#99000000" IsVisible="{Binding IsAddEditPopupVisible, FallbackValue=False}">
            <Border Width="450" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Background="#FEFEFE"
                    CornerRadius="14"
                    Padding="32,28"
                    BoxShadow="0 10 40 0 #40000000">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4" Margin="0,0,0,8">
                        <TextBlock Text="{Binding PopupTitle, FallbackValue='Nowy projekt'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1a1a2e"/>
                        <TextBlock Text="Wprowadź szczegóły dotyczące projektu."
                                   FontSize="12"
                                   Foreground="#7a8099"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Nazwa projektu" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-input" Classes.invalid="{Binding IsNameInvalid}" Watermark="np. Łazik marsjański UR-1" Text="{Binding NewProjectName}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, 10, *">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Data rozpoczęcia" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                            <TextBox Classes="form-input" Classes.invalid="{Binding IsDateStartInvalid}" Watermark="np. 24.05.2026" Text="{Binding NewProjectDateStart}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Data zakończenia" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                            <TextBox Classes="form-input" Classes.invalid="{Binding IsDateEndInvalid}" Watermark="np. 31.12.2026" Text="{Binding NewProjectDateEnd}"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*, 10, *">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Szacowany czas (godz)" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                            <TextBox Classes="form-input" Classes.invalid="{Binding IsEstTimeInvalid}" Watermark="np. 120" Text="{Binding NewProjectEstimatedTime}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Repozytorium GitHub" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                            <TextBox Classes="form-input" Watermark="np. github.com/user/repo" Text="{Binding NewProjectGithub}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Lider projektu" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <ComboBox Classes="form-select" ItemsSource="{Binding ClubMembers}" SelectedItem="{Binding NewProjectLeader, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Wybierz lidera">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="mu:Member">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding FirstName}" />
                                        <TextBlock Text="{Binding LastName}" />
                                        <TextBlock Text=" - " Foreground="Gray"/>
                                        <TextBlock Text="{Binding IndexNumber}" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Opis projektu" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-textarea" Watermark="Krótki opis projektu..." Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12,8" Text="{Binding NewProjectDescription}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Dodatkowe informacje / Uwagi" FontSize="11" FontWeight="SemiBold" Foreground="#7a8099"/>
                        <TextBox Classes="form-textarea" Watermark="Dodatkowe uwagi dotyczące projektu..." Height="45" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12,8" Text="{Binding NewProjectAdditionalInfo}"/>
                    </StackPanel>

                    <Border Height="1" Background="#f0f2f8" Margin="0,4,0,4"/>

                    <!-- Komunikat błędu -->
                    <TextBlock Text="{Binding ValidationError}"
                               Foreground="#D32F2F" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"
                               IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Grid ColumnDefinitions="*, 12, *">
                        <Button Grid.Column="0"
                                Content="Anuluj"
                                Classes="popup-btn popup-cancel"
                                Command="{Binding ClosePopupCommand}"/>

                        <Button Grid.Column="2"
                                Content="Zapisz projekt"
                                Classes="popup-btn popup-primary"
                                IsEnabled="{Binding IsFormValid}"
                                Command="{Binding SaveProjectCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>